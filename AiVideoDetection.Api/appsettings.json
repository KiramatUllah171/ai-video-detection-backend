{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ai_video_detection_db;Username=postgres;Password=123456789"
  },

  "Jwt": {
    "Issuer": "AiVideoDetection.Api",
    "Audience": "AiVideoDetection.Client",
    "Secret": "development-only-jwt-secret-change-before-production",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },

  "VideoProcessing": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "WorkingRootPath": "storage/work",
    "ThumbnailTimestampSeconds": 1,
    "FrameIntervalSeconds": 2,
    "MaxExtractedFrames": 30,
    "FrameImageQuality": 2,
    "FrameOutputFormat": "jpg"
  },

  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "AnalyzeFramesPath": "/analyze-frames",
    "HealthPath": "/health",
    "TimeoutSeconds": 60,
    "MaxFramesPerRequest": 30
  },

  "Scoring": {
    "VisualWeight": 0.70,
    "MetadataWeight": 0.20,
    "TemporalWeight": 0.10,
    "LikelyAiThreshold": 0.75,
    "SuspiciousThreshold": 0.55,
    "InconclusiveThreshold": 0.35,
    "MinimumConfidenceForStrongLabel": 0.65,
    "HighFrameScoreThreshold": 0.75,
    "MediumFrameScoreThreshold": 0.55,
    "MaxFrameEvidenceItems": 10
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
