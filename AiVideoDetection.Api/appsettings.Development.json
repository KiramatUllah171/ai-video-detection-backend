{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ai_video_detection_db;Username=postgres;Password=123456789"
  },
  "Jwt": {
    "Issuer": "AiVideoDetection.Api",
    "Audience": "AiVideoDetection.Client",
    "Secret": "development-only-jwt-secret-change-before-production",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "VideoUpload": {
    "MaxFileSizeBytes": 524288000,
    "AllowedExtensions": [
      ".mp4",
      ".mov",
      ".avi",
      ".mkv",
      ".webm"
    ],
    "AllowedContentTypes": [
      "video/mp4",
      "video/quicktime",
      "video/x-msvideo",
      "video/x-matroska",
      "video/webm",
      "application/octet-stream"
    ],
    "MaxDurationSeconds": 3600
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/private"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
