  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "VideoUpload": {
    "MaxFileSizeBytes": 524288000,
    "AllowedExtensions": [
      ".mp4",
      ".mov",
      ".avi",
      ".mkv",
      ".webm"
    ],
    "AllowedContentTypes": [
      "video/mp4",
      "video/quicktime",
      "video/x-msvideo",
      "video/avi",
      "video/msvideo",
      "video/x-matroska",
      "video/matroska",
      "video/mkv",
      "video/x-mkv",
      "application/x-matroska",
      "video/webm",
      "application/octet-stream"
    ],
    "MaxDurationSeconds": 3600
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/private"
  },
  "VideoProcessing": {
    "FfmpegPath": "C:\\Users\\iamki\\AppData\\Local\\Microsoft\\WinGet\\Links\\ffmpeg.exe",
    "FfprobePath": "C:\\Users\\iamki\\AppData\\Local\\Microsoft\\WinGet\\Links\\ffprobe.exe",
    "WorkingRootPath": "storage/work",
    "ThumbnailTimestampSeconds": 1,
    "FrameIntervalSeconds": 2,
    "MaxExtractedFrames": 30,
    "FrameImageQuality": 2,
    "FrameOutputFormat": "jpg",
    "MaxConcurrentProviderRequests": 2
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "AnalyzeFramesPath": "/analyze-frames",
    "AnalyzeVideoPath": "/analyze-video",
    "HealthPath": "/health",
    "ApiKey": "",
    "TimeoutSeconds": 300,
    "MaxFramesPerRequest": 32,
    "FrameSamplingStrategy": "uniform",
    "ProviderMode": "local",
    "BitMindEnabled": false,
    "BitMindMonthlyQuota": 100,
    "LocalFallbackEnabled": true,
    "ExternalProviderPolicy": "OnUncertain"
  },
  "Scoring": {
    "VisualWeight": 0.90,
    "MetadataWeight": 0.10,
    "TemporalWeight": 0.00,
    "VideoDetectorMaxWeight": 0.65,
    "FrameDetectorMaxWeight": 0.35,
    "NormalizeMissingWeights": true,
    "MeanFrameScoreWeight": 0.45,
    "TopKFrameScoreWeight": 0.35,
    "P90FrameScoreWeight": 0.20,
    "LikelyAiThreshold": 0.70,
    "SuspiciousThreshold": 0.50,
    "InconclusiveThreshold": 0.30,
    "MinimumConfidenceForStrongLabel": 0.60,
    "HighFrameScoreThreshold": 0.75,
    "MediumFrameScoreThreshold": 0.55,
    "ModelDisagreementThreshold": 0.30,
    "StrongRawFrameThreshold": 0.85,
    "StrongCalibratedFrameThreshold": 0.65,
    "RequireAgreementForLikelyAi": true,
    "AllowSingleDetectorSuspicious": true,
    "MinimumDetectorReliabilityForSingleDetectorSuspicious": 0.50,
    "MaxFrameEvidenceItems": 10
  },
  "InternalMatching": {
    "Enabled": true,
    "HashVersion": "mvp-v1",
    "MaxCandidateVideos": 200,
    "MaxFramesPerVideoToCompare": 30,
    "MaxMatchesToStore": 10,
    "HammingDistanceThreshold": 18,
    "MinimumMatchedFrames": 2,
    "MinimumSimilarityScore": 0.55,
    "HighConfidenceThreshold": 0.80,
    "MediumConfidenceThreshold": 0.65,
    "HashSimilarityWeight": 0.70,
    "DurationSimilarityWeight": 0.20,
    "MetadataSimilarityWeight": 0.10,
    "PlaceholderHashMode": true,
    "FailJobOnMatchingError": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
