{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ai_video_detection_db;Username=postgres;Password=123456789"
  },
  "Jwt": {
    "Issuer": "AiVideoDetection.Api",
    "Audience": "AiVideoDetection.Client",
    "Secret": "development-only-jwt-secret-change-before-production",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "VideoUpload": {
    "MaxFileSizeBytes": 524288000,
    "AllowedExtensions": [
      ".mp4",
      ".mov",
      ".avi",
      ".mkv",
      ".webm"
    ],
    "AllowedContentTypes": [
      "video/mp4",
      "video/quicktime",
      "video/x-msvideo",
      "video/x-matroska",
      "video/webm",
      "application/octet-stream"
    ],
    "MaxDurationSeconds": 3600
  },
  "Storage": {
    "Provider": "Local",
    "LocalRootPath": "storage/private"
  },
  "VideoProcessing": {
    "FfmpegPath": "C:\\Users\\iamki\\AppData\\Local\\Microsoft\\WinGet\\Links\\ffmpeg.exe",
    "FfprobePath": "C:\\Users\\iamki\\AppData\\Local\\Microsoft\\WinGet\\Links\\ffprobe.exe",
    "WorkingRootPath": "storage/work",
    "ThumbnailTimestampSeconds": 1,
    "FrameIntervalSeconds": 2,
    "MaxExtractedFrames": 30,
    "FrameImageQuality": 2,
    "FrameOutputFormat": "jpg"
  },
  "AiService": {
    "BaseUrl": "http://localhost:8000",
    "AnalyzeFramesPath": "/analyze-frames",
    "HealthPath": "/health",
    "TimeoutSeconds": 60,
    "MaxFramesPerRequest": 30
  },
  "Scoring": {
    "VisualWeight": 0.70,
    "MetadataWeight": 0.20,
    "TemporalWeight": 0.10,
    "LikelyAiThreshold": 0.75,
    "SuspiciousThreshold": 0.55,
    "InconclusiveThreshold": 0.35,
    "MinimumConfidenceForStrongLabel": 0.65,
    "HighFrameScoreThreshold": 0.75,
    "MediumFrameScoreThreshold": 0.55,
    "MaxFrameEvidenceItems": 10
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
