{
  "ConnectionStrings": {
    "DefaultConnection": "__SET_IN_SECRET_MANAGER__"
  },
  "Jwt": {
    "Issuer": "SachAI.Api",
    "Audience": "SachAI.Client",
    "Secret": "__SET_IN_SECRET_MANAGER__",
    "AccessTokenMinutes": 30,
    "RefreshTokenMinutes": 1440,
    "RefreshTokenDays": 7
  },
  "PasswordReset": {
    "FrontendBaseUrl": "https://__FRONTEND_DOMAIN__",
    "Provider": "Smtp",
    "Host": "__SMTP_HOST__",
    "Port": 587,
    "UseStartTls": true,
    "UseSsl": false,
    "Username": "__SMTP_USERNAME__",
    "Password": "__SET_IN_SECRET_MANAGER__",
    "SenderEmail": "__SENDER_EMAIL__",
    "SenderName": "SachAI",
    "SmtpHost": "__SMTP_HOST__",
    "SmtpPort": 587,
    "SmtpEnableSsl": true,
    "SmtpUsername": "__SMTP_USERNAME__",
    "SmtpPassword": "__SET_IN_SECRET_MANAGER__",
    "FromEmail": "__SENDER_EMAIL__",
    "FromName": "SachAI"
  },
  "DataProtection": {
    "ApplicationName": "SachAI",
    "KeyRingPath": "__PERSISTENT_KEY_RING_PATH__"
  },
  "Encryption": {
    "Enabled": true,
    "EncryptStorageObjects": true,
    "EncryptDatabaseFields": true,
    "AllowPlaintextFallback": true,
    "MasterKeyBase64": "__SET_32_BYTE_BASE64_KEY_IN_SECRET_MANAGER__"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "DeploymentReadiness": {
    "RequireHttps": true,
    "DatabaseBackupConfigured": true,
    "ReportStorageBackupConfigured": true,
    "MigrationReleaseProcessConfigured": true,
    "HealthChecksConnected": true,
    "MonitoringDashboardConfigured": true,
    "MonitoringDashboardUrl": "https://__MONITORING_DASHBOARD_URL__"
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "ForwardLimit": 1,
    "KnownProxies": [
      "__TRUSTED_PROXY_IP__"
    ],
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": [
      "https://__FRONTEND_DOMAIN__"
    ]
  },
  "SecurityHeaders": {
    "Enabled": true,
    "EnableHsts": true,
    "HstsMaxAgeDays": 365,
    "ContentSecurityPolicy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://__API_DOMAIN__",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  },
  "AiService": {
    "BaseUrl": "https://__AI_SERVICE_DOMAIN__",
    "ApiKey": "__SET_IN_SECRET_MANAGER__",
    "ProviderMode": "hybrid",
    "BitMindEnabled": true,
    "BitMindMonthlyQuota": 100,
    "LocalFallbackEnabled": true,
    "ExternalProviderPolicy": "OnUncertain"
  },
  "Payments": {
    "MockEnabled": false,
    "PendingPaymentExpiryMinutes": 30,
    "OrderPrefix": "SACHAI"
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPermitLimit": 10,
    "AuthSensitivePermitLimit": 20,
    "RefreshPermitLimit": 60,
    "UploadPermitLimit": 10,
    "VideoActionPermitLimit": 30,
    "SubscriptionPermitLimit": 120,
    "PaymentPermitLimit": 20,
    "PaymentCallbackPermitLimit": 60,
    "ReportDownloadPermitLimit": 30,
    "AdminPermitLimit": 120,
    "GeneralApiPermitLimit": 300,
    "WindowSeconds": 60
  },
  "SubscriptionSecurity": {
    "HmacSecret": "__SET_IN_SECRET_MANAGER__",
    "DeviceCookieName": "sachai_device",
    "DeviceCookieDays": 365,
    "RequireSecureDeviceCookieInDevelopment": false,
    "DeviceFingerprintHeaderName": "X-SachAI-Device-Fingerprint"
  },
  "ScanReservations": {
    "UnlinkedReservationTtlMinutes": 60,
    "ActiveJobSafetyMarginMinutes": 5,
    "ReconciliationBatchSize": 100
  },
  "VideoStorageProtection": {
    "EnableFreeDiskChecks": true,
    "UploadTempRootPath": "storage/upload-temp",
    "MultipartTempSpaceMultiplier": 1.05,
    "UploadTempSpaceMultiplier": 1.10,
    "LocalStorageSpaceMultiplier": 1.10,
    "ProcessingWorkingSpaceMultiplier": 4.00,
    "MinimumFreeSpaceReserveBytes": 1073741824,
    "MaxConcurrentUploads": 3,
    "MaxConcurrentProcessingJobs": 2,
    "UploadConcurrencyWaitTimeoutSeconds": 5,
    "OrphanUploadTempRetentionHours": 4
  },
  "Easypaisa": {
    "Enabled": false,
    "CheckoutBaseUrl": "__SET_OFFICIAL_EASYPAISA_CHECKOUT_URL__",
    "MerchantId": "__SET_IN_SECRET_MANAGER__",
    "StoreId": "__SET_IN_SECRET_MANAGER__",
    "CallbackSecret": "__SET_IN_SECRET_MANAGER__"
  },
  "AllowedHosts": "__API_DOMAIN__"
}
